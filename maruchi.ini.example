# Maruchi 联机配置文件 (UTF-8，保存后重启游戏生效)
# 优先级：环境变量 > 本文件 (maruchi.ini) > 默认值

# 服务器地址 (填写房主/云服务器的 IP 或域名；本机单人测试填 127.0.0.1)
host = 127.0.0.1
port = 27890

# 玩家昵称 (支持中文，建议不超过 12 个字符)
name = Player

# 初始角色 ID (1 = 洛克人；进入游戏后可随时按 F8 切换全部 137 名角色)
actor_id = 1

# 启动游戏后是否自动连接服务器 (1 = 自动连接，0 = 在标题/地图按 F7 手动连接)
auto_join = 0
